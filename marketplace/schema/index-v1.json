{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elysiafloat.local/schema/plugin-market-index-v1.json",
  "title": "ElysiaFloat Plugin Market Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["indexVersion", "manifestVersion", "plugins"],
  "properties": {
    "indexVersion": { "const": 1 },
    "manifestVersion": { "const": 1 },
    "generatedAt": { "type": "string", "maxLength": 64 },
    "source": { "type": "string", "maxLength": 500 },
    "trustPolicy": { "type": "string", "maxLength": 200 },
    "plugins": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "manifest", "permissions", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{2,64}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "version": { "type": "string", "minLength": 1, "maxLength": 24 },
          "author": { "type": "string", "maxLength": 48 },
          "description": { "type": "string", "maxLength": 300 },
          "manifest": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "docs": { "type": "string", "maxLength": 1000 },
          "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "trust": { "type": "string", "maxLength": 40 },
          "reviewStatus": { "type": "string", "maxLength": 40 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    }
  }
}
